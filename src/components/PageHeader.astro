---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<div class="page-header">
  <div class="container">
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
  </div>
</div>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--c-primary-soft), var(--c-bg) 70%);
    border-bottom: 1px solid var(--c-border);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .page-header h1 {
    margin-bottom: 0.4em;
  }

  .page-header p {
    max-width: 46rem;
    font-size: 1.15rem;
    color: var(--c-text-muted);
    margin: 0;
  }
</style>

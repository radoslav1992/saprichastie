---
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import { useTranslations, type Lang } from '../../i18n';
import { galleryImages } from '../../data/gallery';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} path="/gallery" title={t.gallery.title} description={t.gallery.intro}>
  <PageHeader title={t.gallery.title} intro={t.gallery.intro} />

  <section class="section" aria-label={t.gallery.title}>
    <div class="container">
      <ul class="gallery-grid" id="gallery-grid">
        {
          galleryImages.map((img, i) => (
            <li>
              <button
                type="button"
                class="gallery-item"
                data-index={i}
                data-src={img.src}
                data-alt={img.alt[lang]}
                aria-label={`${t.gallery.viewImage}: ${img.alt[lang]}`}
              >
                <img
                  src={img.src}
                  alt={img.alt[lang]}
                  width={img.width}
                  height={img.height}
                  loading="lazy"
                />
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Lightbox -->
  <dialog class="lightbox" id="lightbox" aria-label={t.gallery.title}>
    <div class="lightbox-bar">
      <p class="lightbox-counter" id="lightbox-counter" aria-live="polite"></p>
      <button type="button" class="lightbox-btn" id="lightbox-close" aria-label={t.gallery.close}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <div class="lightbox-stage">
      <button type="button" class="lightbox-btn lightbox-nav" id="lightbox-prev" aria-label={t.gallery.prev}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      </button>
      <figure>
        <img id="lightbox-img" src="" alt="" />
        <figcaption id="lightbox-caption"></figcaption>
      </figure>
      <button type="button" class="lightbox-btn lightbox-nav" id="lightbox-next" aria-label={t.gallery.next}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </dialog>
</Base>

<style>
  .gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }

  .gallery-item {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: zoom-in;
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }

  .gallery-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.045);
  }

  /* Lightbox */
  .lightbox {
    border: none;
    padding: 0;
    width: min(100vw, 100%);
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    background: rgb(10 20 25 / 0.96);
    color: #fff;
  }

  .lightbox::backdrop {
    background: rgb(10 20 25 / 0.85);
  }

  .lightbox-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1.2rem;
  }

  .lightbox-counter {
    margin: 0;
    font-weight: 650;
    opacity: 0.85;
  }

  .lightbox-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 0.35);
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    cursor: pointer;
    flex-shrink: 0;
  }

  .lightbox-btn:hover {
    background: rgb(255 255 255 / 0.22);
  }

  .lightbox-btn svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0 1rem 1.4rem;
    height: calc(100vh - 4.7rem);
  }

  .lightbox figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    max-width: calc(100vw - 10rem);
    max-height: 100%;
  }

  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 12rem);
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .lightbox figcaption {
    text-align: center;
    font-size: 1rem;
    opacity: 0.92;
    max-width: 46rem;
  }

  @media (max-width: 640px) {
    .lightbox-stage {
      flex-wrap: wrap;
    }

    .lightbox figure {
      max-width: 100%;
      order: -1;
    }
  }
</style>

<script>
  const grid = document.getElementById('gallery-grid');
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbCaption = document.getElementById('lightbox-caption');
  const lbCounter = document.getElementById('lightbox-counter');

  const items = Array.from(
    grid?.querySelectorAll<HTMLButtonElement>('.gallery-item') ?? []
  );
  let current = 0;

  function show(index: number) {
    if (!items.length || !lbImg || !lbCaption || !lbCounter) return;
    current = (index + items.length) % items.length;
    const btn = items[current];
    lbImg.src = btn.dataset.src ?? '';
    lbImg.alt = btn.dataset.alt ?? '';
    lbCaption.textContent = btn.dataset.alt ?? '';
    lbCounter.textContent = `${current + 1} / ${items.length}`;
  }

  items.forEach((btn) => {
    btn.addEventListener('click', () => {
      show(Number(btn.dataset.index ?? 0));
      lightbox?.showModal();
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', () => lightbox?.close());
  document.getElementById('lightbox-prev')?.addEventListener('click', () => show(current - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => show(current + 1));

  lightbox?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Close when clicking the backdrop (outside the stage content)
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });
</script>

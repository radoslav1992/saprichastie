---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import computerTraining from '../../assets/photos/computer-training.jpg';
import showdownPractice from '../../assets/photos/showdown-practice.jpg';
import supportGroup from '../../assets/photos/support-group.jpg';
import urbanOrientation from '../../assets/photos/urban-orientation.jpg';
import brailleTrainingChildren from '../../assets/photos/braille-training-children.jpg';
import whiteCaneDemonstration from '../../assets/photos/white-cane-demonstration.jpg';
import centerGroup from '../../assets/photos/center-group.jpg';
import mobilityObstacles from '../../assets/photos/mobility-obstacles.jpg';
import kindnessMessage from '../../assets/photos/kindness-message.jpg';
import Base from '../../layouts/Base.astro';
import ReadButton from '../ReadButton.astro';
import { type Lang, useTranslations } from '../../i18n';
import type { GalleryItem } from '../../lib/gallery';

interface Props {
  lang: Lang;
  /** Admin-managed photos; null falls back to the built-in set below. */
  items?: GalleryItem[] | null;
}

const { lang, items = null } = Astro.props;
const t = useTranslations(lang);
const g = t.gallery;

const photos: Record<string, ImageMetadata> = {
  'computer-training': computerTraining,
  'showdown-practice': showdownPractice,
  'support-group': supportGroup,
  'urban-orientation': urbanOrientation,
  'braille-training-children': brailleTrainingChildren,
  'white-cane-demonstration': whiteCaneDemonstration,
  'center-group': centerGroup,
  'mobility-obstacles': mobilityObstacles,
  'kindness-message': kindnessMessage,
};
---

<Base lang={lang} path="/gallery" title={g.metaTitle} description={g.intro}>
  <div class="page-head">
    <div class="page-head__inner">
      <span class="eyebrow">{g.eyebrow}</span>
      <h1>{g.title}</h1>
      <p class="intro">{g.intro}</p>
      <p class="gallery-count">
        {items ? items.length : g.items.length}{' '}
        {lang === 'bg'
          ? 'момента от нашата общност'
          : 'moments from our community'}
      </p>
    </div>
  </div>

  <section class="container gallery">
    <div class="gallery__grid">
      {items
        ? items.map((item) => {
            const caption = lang === 'bg' ? item.captionBg : item.captionEn;
            return (
              <figure class="card gallery-item" data-read>
                <div class="gallery-item__media">
                  <img
                    src={`/media/${item.key}`}
                    alt={caption}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption>
                  <span data-caption>{caption}</span>
                  <ReadButton lang={lang} />
                </figcaption>
              </figure>
            );
          })
        : g.items.map((item) => (
            <figure class="card gallery-item" data-read>
              <div class="gallery-item__media">
                <Image
                  src={photos[item.key]}
                  alt={item.caption}
                  widths={[420, 720, 1080]}
                  sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 400px"
                />
              </div>
              <figcaption>
                <span data-caption>{item.caption}</span>
                <ReadButton lang={lang} />
              </figcaption>
            </figure>
          ))}
    </div>
    <p class="muted gallery__note">
      {g.submitNote} <a href={`mailto:${t.email}`}>{t.email}</a> {g.submitNote2}
    </p>
  </section>
</Base>

<style>
  .gallery {
    padding-top: 52px;
    padding-bottom: 90px;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }

  .gallery-item {
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .gallery-item__media {
    position: relative;
    height: 240px;
    border-bottom: var(--border);
  }

  .gallery-item__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    padding: 20px;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .gallery__note {
    margin-top: 34px;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .gallery-count {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .gallery__grid {
    gap: 28px;
  }
  .gallery-item__media {
    height: auto;
    aspect-ratio: 4 / 3;
  }
  .gallery-item figcaption {
    line-height: 1.6;
    font-weight: 550;
  }
  .gallery-item :global(.read-btn) {
    display: flex;
    margin-top: 16px;
  }
</style>

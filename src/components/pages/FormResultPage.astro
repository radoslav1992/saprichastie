---
import Base from '../../layouts/Base.astro';
import { type Lang, useTranslations, localizePath } from '../../i18n';

interface Props {
  lang: Lang;
  kind: 'sent' | 'error';
}

const { lang, kind } = Astro.props;
const t = useTranslations(lang);
const r = t.contact[kind];
---

<Base lang={lang} path={`/contact/${kind}`} title={r.metaTitle}>
  <div class="result container">
    <div class:list={['result__panel', kind === 'sent' ? 'accent-panel' : 'card']}>
      <h1 class="display">{r.title}</h1>
      <p>{r.text}</p>
      {
        kind === 'error' && (
          <p class="result__phone">
            <a href={t.phoneHref}>{t.phone}</a>
          </p>
        )
      }
      <div class="result__actions">
        <a href={localizePath(lang, '/contact')} class="btn btn--solid">{r.back}</a>
        {
          kind === 'sent' && (
            <a href={localizePath(lang, '/')} class="btn btn--outline">
              {t.contact.sent.home}
            </a>
          )
        }
      </div>
    </div>
  </div>
</Base>

<style>
  .result {
    padding: 90px 28px 120px;
    display: flex;
    justify-content: center;
  }

  .result__panel {
    max-width: 720px;
    padding: 56px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    border-radius: var(--radius-panel);
  }

  .result__panel h1 {
    font-size: clamp(34px, 4vw, 54px);
  }

  .result__panel p {
    font-size: 21px;
    line-height: 1.6;
  }

  .result__phone a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    text-decoration: none;
    color: inherit;
    border-bottom: 3px solid var(--accent);
  }

  .result__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 8px;
  }

  @media (max-width: 640px) {
    .result__panel {
      padding: 32px;
    }
  }
</style>

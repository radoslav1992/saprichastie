---
import Base from '../../layouts/Base.astro';
import ReadButton from '../ReadButton.astro';
import { type Lang, useTranslations, localizePath } from '../../i18n';
import { archiveBase, formatDuration, trackUrl, type ArchiveItem } from '../../lib/archive';

interface Props {
  lang: Lang;
  id: string | undefined;
  /** Fetched by the route (which also sets the 404 status when null). */
  item: ArchiveItem | null;
}

const { lang, id, item } = Astro.props;
const t = useTranslations(lang);
const l = t.library;

const env = Astro.locals.runtime?.env;
const archiveUrl = item ? `https://archive.org/details/${item.identifier}` : '';
const coverUrl = item ? `${archiveBase(env)}/services/img/${item.identifier}` : '';
const tracks = item?.tracks ?? [];
const totalSeconds = tracks.reduce((sum, track) => sum + (track.seconds ?? 0), 0);
---

<Base
  lang={lang}
  path={`/library/${id ?? ''}`}
  title={item ? item.title : l.notFound}
  description={item?.description ?? l.intro}
  noindex={!item}
>
  <div class="page-head">
    <div class="page-head__inner book-head">
      <p class="book-head__back">
        <a href={localizePath(lang, '/library')}>{l.back}</a>
      </p>
      <span class="eyebrow">{l.eyebrow}</span>
      <h1 class="book-title">{item ? item.title : l.notFound}</h1>
      {
        item && (item.creator || item.year) && (
          <p class="book-meta">
            {item.creator && (
              <span>
                {l.author}: <strong>{item.creator}</strong>
              </span>
            )}
            {item.year && (
              <span class="muted">
                {l.yearWord}: {item.year}
              </span>
            )}
          </p>
        )
      }
    </div>
  </div>

  {
    item && tracks.length > 0 && (
      <section class="container book">
        <p class="book__hint">{l.listen}</p>
        <div
          class="card player"
          role="group"
          aria-label={l.playerLabel}
          data-book-title={item.title}
          data-book-author={item.creator ?? ''}
          data-cover={coverUrl}
        >
          <div class="player__top">
            <img class="player__cover" src={coverUrl} alt="" width="112" height="112" loading="lazy" />
            <div class="player__main">
              <p class="player__now">
                {l.nowPlaying}
                <strong id="np-title" aria-live="polite">{tracks[0].title}</strong>
              </p>
              <audio id="book-audio" controls preload="metadata" src={trackUrl(env, item.identifier, tracks[0].name)} />
              <div class="player__nav" data-noprint>
                <button type="button" id="prev-track" class="player__navbtn" disabled>
                  ⏮ {l.prevChapter}
                </button>
                <button type="button" id="next-track" class="player__navbtn" disabled={tracks.length < 2}>
                  {l.nextChapter} ⏭
                </button>
              </div>
            </div>
          </div>

          <div class="player__list">
            <h2 class="player__chapters-title">
              {l.chapters} ({tracks.length})
              {totalSeconds > 0 && (
                <span class="muted player__total">
                  · {l.totalDuration} {formatDuration(totalSeconds)}
                </span>
              )}
            </h2>
            <ol class="tracks">
              {tracks.map((track, i) => (
                <li>
                  <a
                    href={trackUrl(env, item.identifier, track.name)}
                    class="track"
                    data-track={i}
                    aria-current={i === 0 ? 'true' : undefined}
                  >
                    <span class="track__num" aria-hidden="true">{i + 1}</span>
                    <span class="track__title">{track.title}</span>
                    {track.seconds != null && <span class="track__time muted">{formatDuration(track.seconds)}</span>}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
        <p class="book__external">
          <a href={archiveUrl} rel="noopener">{l.openOnArchive} ↗</a>
        </p>

        {item.description && (
          <div class="book__about" data-read>
            <h2>{l.aboutBook}</h2>
            <p>{item.description}</p>
            <ReadButton lang={lang} />
          </div>
        )}
      </section>
    )
  }
  {
    item && tracks.length === 0 && (
      <section class="container book">
        <p class="notice card">{l.noAudio}</p>
        <p class="book__external">
          <a href={archiveUrl} rel="noopener" class="btn btn--solid">{l.openOnArchive} ↗</a>
        </p>
      </section>
    )
  }
  {
    !item && (
      <section class="container book">
        <p class="notice card">{l.notFound}</p>
        <p class="book__external">
          <a href={localizePath(lang, '/library')} class="btn btn--solid">{l.back}</a>
        </p>
      </section>
    )
  }
</Base>

<script>
  /*
   * Chapter navigation around the native <audio> element: clicking a
   * chapter plays it, tracks auto-advance, prev/next buttons and
   * lock-screen (Media Session) controls stay in sync. Without JS every
   * chapter link simply opens its MP3 directly.
   */
  const audio = document.getElementById('book-audio') as HTMLAudioElement | null;
  const player = document.querySelector<HTMLElement>('.player');

  if (audio && player) {
    const tracks = [...document.querySelectorAll<HTMLAnchorElement>('.track')];
    const npTitle = document.getElementById('np-title');
    const prevBtn = document.getElementById('prev-track') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('next-track') as HTMLButtonElement | null;
    let current = 0;

    const trackTitle = (i: number) =>
      tracks[i]?.querySelector('.track__title')?.textContent ?? String(i + 1);

    function select(index: number, play: boolean) {
      if (!audio || index < 0 || index >= tracks.length) return;
      current = index;
      audio.src = tracks[index].href;
      if (npTitle) npTitle.textContent = trackTitle(index);
      tracks.forEach((a, i) => {
        if (i === index) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === tracks.length - 1;
      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: trackTitle(index),
          artist: player?.dataset.bookAuthor || undefined,
          album: player?.dataset.bookTitle || undefined,
          artwork: player?.dataset.cover ? [{ src: player.dataset.cover }] : [],
        });
      }
      if (play) audio.play().catch(() => {});
    }

    tracks.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        select(i, true);
      })
    );
    prevBtn?.addEventListener('click', () => select(current - 1, true));
    nextBtn?.addEventListener('click', () => select(current + 1, true));
    audio.addEventListener('ended', () => {
      if (current < tracks.length - 1) select(current + 1, true);
    });

    if ('mediaSession' in navigator) {
      navigator.mediaSession.setActionHandler('previoustrack', () => select(current - 1, true));
      navigator.mediaSession.setActionHandler('nexttrack', () => select(current + 1, true));
      select(0, false);
    }
  }
</script>

<style>
  .book-head__back {
    font-size: 17px;
  }

  .book-head__back a {
    font-weight: 700;
    text-decoration: none;
  }

  .book-title {
    overflow-wrap: anywhere;
  }

  .book-meta {
    font-size: 19px;
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }

  .book {
    padding-top: 44px;
    padding-bottom: 90px;
  }

  .book__hint {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .player {
    border-radius: var(--radius-panel);
    overflow: hidden;
  }

  .player__top {
    display: flex;
    gap: 24px;
    align-items: center;
    padding: 28px;
    border-bottom: var(--border);
    flex-wrap: wrap;
  }

  .player__cover {
    width: 112px;
    height: 112px;
    flex: none;
    object-fit: cover;
    border: var(--border);
    border-radius: 14px;
    background: var(--lavender);
  }

  .player__main {
    flex: 1;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .player__now {
    font-size: 18px;
  }

  .player__now strong {
    font-weight: 800;
  }

  audio {
    width: 100%;
  }

  .player__nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .player__navbtn {
    padding: 10px 20px;
    background: none;
    border: var(--border);
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
  }

  .player__navbtn:hover:not(:disabled) {
    background: var(--accent);
  }

  .player__navbtn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .player__list {
    padding: 24px 28px 28px;
  }

  .player__chapters-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .player__total {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0;
  }

  .tracks {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .track {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 10px;
    border-bottom: 2px solid var(--border-soft);
    text-decoration: none;
    color: inherit;
    font-size: 18px;
    border-radius: 8px;
  }

  .track:hover {
    background: var(--lavender);
    color: inherit;
  }

  .track[aria-current='true'] {
    background: var(--accent);
    font-weight: 700;
  }

  .track__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    min-width: 26px;
  }

  .track__title {
    flex: 1;
    overflow-wrap: anywhere;
  }

  .track__time {
    font-variant-numeric: tabular-nums;
    font-size: 16px;
  }

  .book__external {
    margin-top: 16px;
    font-size: 18px;
  }

  .book__about {
    margin-top: 40px;
    max-width: 70ch;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .book__about h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .book__about p {
    font-size: 19px;
    line-height: 1.65;
  }

  .notice {
    padding: 26px 30px;
    font-size: 19px;
    max-width: 62ch;
    margin-bottom: 20px;
  }

  @media (max-width: 560px) {
    .player__top,
    .player__list {
      padding: 20px;
    }
  }
</style>

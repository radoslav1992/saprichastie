---
import Base from '../../layouts/Base.astro';
import ReadButton from '../ReadButton.astro';
import { type Lang, useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const f = t.faq;

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: f.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base lang={lang} path="/faq" title={f.metaTitle} description={f.intro} extraLd={[faqLd]}>
  <div class="page-head">
    <div class="page-head__inner">
      <span class="eyebrow">{f.eyebrow}</span>
      <h1>{f.title}</h1>
      <p class="intro">{f.intro}</p>
    </div>
  </div>

  <section data-read class="container faq">
    <div class="faq__list">
      {
        f.items.map((item) => (
          <article class="card faq-item">
            <h2>{item.q}</h2>
            <p>{item.a}</p>
          </article>
        ))
      }
    </div>
    <ReadButton lang={lang} />
  </section>
</Base>

<style>
  .faq {
    padding-top: 52px;
    padding-bottom: 90px;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 860px;
  }

  .faq-item {
    padding: 30px 34px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .faq-item p {
    font-size: 19px;
    line-height: 1.65;
  }

  @media (max-width: 560px) {
    .faq-item {
      padding: 22px;
    }
  }
</style>

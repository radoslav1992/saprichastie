---
import { Image } from 'astro:assets';
import logoWhite from '../assets/logo-white.png';
import { type Lang, useTranslations, localizePath } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// stamped at build time, i.e. the date of the last deploy
const updatedDate = new Intl.DateTimeFormat(lang === 'bg' ? 'bg-BG' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());
const updatedIso = new Date().toISOString().slice(0, 10);

const navItems = [
  { href: '/', label: t.nav.home },
  { href: '/about', label: t.nav.about },
  { href: '/services', label: t.nav.services },
  { href: '/activities', label: t.nav.activities },
  { href: '/gallery', label: t.nav.gallery },
  { href: '/library', label: t.nav.library },
  { href: '/contact', label: t.nav.contacts },
  { href: '/faq', label: t.nav.faq },
];
---

<footer>
  <div class="footer-main">
    <div class="footer-brand">
      <div class="footer-brand__row">
        <Image src={logoWhite} alt="" width={88} height={88} densities={[1, 2]} class="footer-logo" />
        <span class="footer-brand__name">{t.site.name}</span>
      </div>
      <p class="footer-mission">{t.footer.mission}</p>
    </div>

    <div class="footer-col">
      <h2>{t.footer.contactTitle}</h2>
      <p class="footer-address">
        {t.footer.addressLine1}<br />
        {t.footer.addressLine2}
      </p>
      <a href={t.phoneHref}>{t.phone}</a>
      <a href={`mailto:${t.email}`}>{t.email}</a>
    </div>

    <nav aria-label={t.footer.navLabel} class="footer-col">
      <h2>{t.footer.pagesTitle}</h2>
      {navItems.map((item) => <a href={localizePath(lang, item.href)}>{item.label}</a>)}
    </nav>
  </div>

  <div class="footer-bottom">
    <p>
      {t.footer.copyright}
      <br />
      {t.footer.updated} <time datetime={updatedIso}>{updatedDate}</time>
    </p>
    <p class="footer-bottom__note">{t.footer.a11yNote}</p>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    color: var(--bg);
    border-top: var(--border);
  }

  .footer-main {
    max-width: var(--container);
    margin: 0 auto;
    padding: 70px 28px 34px;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 48px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-brand__row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer-logo {
    width: 48px;
    height: 48px;
    flex: none;
    object-fit: contain;
  }

  .footer-brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.02em;
  }

  .footer-mission {
    font-size: 19px;
    line-height: 1.6;
    max-width: 40ch;
    color: var(--footer-text);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col h2 {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .footer-address {
    font-size: 18px;
    line-height: 1.6;
    color: var(--footer-text);
  }

  .footer-col a {
    font-size: 18px;
    color: var(--footer-text);
    text-decoration: none;
    align-self: flex-start;
  }

  .footer-col a:hover {
    color: var(--accent);
    background: none;
  }

  .footer-bottom {
    max-width: var(--container);
    margin: 0 auto;
    padding: 24px 28px 44px;
    border-top: 2px solid var(--footer-border);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
  }

  .footer-bottom p {
    font-size: 16px;
    color: var(--footer-dim);
  }

  .footer-bottom__note {
    max-width: 52ch;
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>

/**
 * Cloudflare Worker configuration for the Saprichastie website.
 *
 * The site is an Astro static build with one server endpoint
 * (POST /api/contact) that sends contact-form submissions through
 * Cloudflare Email Routing.
 *
 * Before the contact form can deliver mail you must, in the Cloudflare
 * dashboard for the saprichastie.org zone:
 *   1. Enable Email Routing.
 *   2. Verify the destination mailbox (CONTACT_TO below) as a
 *      destination address.
 * The sender (CONTACT_FROM) must be an address on the saprichastie.org
 * domain — it does not need to be a real mailbox.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saprichastie",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Runs automatically before `wrangler deploy` / `wrangler dev`, so a bare
  // `npx wrangler deploy` (e.g. in Cloudflare Workers Builds) produces dist/
  // before wrangler looks for it.
  "build": {
    "command": "npm install && npm run build"
  },
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // Email Routing binding used by /api/contact to send the form as email.
  "send_email": [
    {
      "name": "CONTACT_EMAIL"
    }
  ],
  // Gallery admin panel (/admin). The ADMIN_PASSWORD secret is set in the
  // dashboard (Workers & Pages → saprichastie → Settings → Variables and
  // Secrets) and persists across deploys.
  "kv_namespaces": [
    {
      "binding": "GALLERY_KV",
      "id": "563fbe53d1a14304a26a4540ccec7049"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GALLERY_BUCKET",
      "bucket_name": "saprichastie-gallery"
    }
  ],
  "vars": {
    // Envelope sender: any address on the saprichastie.org domain.
    "CONTACT_FROM": "website@saprichastie.org",
    // Where contact-form messages are delivered. Must be a verified
    // destination address in Cloudflare Email Routing.
    "CONTACT_TO": "info@saprichastie.org"
  }
}
